// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lifecycle of a payroll event.
/// received → queued → processing → success | failed
enum EventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

/// One submitted payroll event. Per-employee ordering is enforced by
/// UNIQUE (employee_id, sequence); idempotency is enforced by the shared
/// idempotency_records store (UNIQUE (scope, key)), NOT by this table.
/// idempotency_key is retained as a non-unique index for traceability only.
model PayrollEvent {
  id             String      @id @default(uuid())
  eventType      String      @map("event_type")
  employeeId     String      @map("employee_id")
  payload        Json        @db.JsonB
  sequence       BigInt
  idempotencyKey String      @map("idempotency_key")
  status         EventStatus @default(RECEIVED)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  processedAt    DateTime?   @map("processed_at")
  /// Result of the simulated external payroll operation, set only on success.
  result         Json?       @map("result")

  @@unique([employeeId, sequence])
  @@index([idempotencyKey])
  @@index([status])
  @@index([employeeId, createdAt])
  @@map("payroll_events")
}

/// Shared idempotency store: one record per (scope, key) carrying the stored
/// HTTP response, with TTL expiry. The UNIQUE (scope, key) constraint is the
/// arbiter of idempotency for any endpoint that adopts the layer.
model IdempotencyRecord {
  id             String   @id @default(uuid())
  scope          String   @map("scope")
  key            String   @map("key")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Terminal outcome of one processing attempt (append-only audit trail).
enum AttemptStatus {
  SUCCESS
  FAILED
}

/// Why a failed attempt failed. TEMPORARY = a transient failure: the attempt is
/// retried, and the row may be the mid-retry record or the exhausted final
/// attempt. PERMANENT = business rejection that retrying would not fix.
enum AttemptErrorType {
  TEMPORARY
  PERMANENT
}

/// Append-only audit trail of every processing attempt, at most one row per
/// attempt number per event (UNIQUE (event_id, attempt_number)). A terminal
/// attempt's row is inserted in the SAME database transaction as the
/// `payroll_events` terminal transition (design D1): a SUCCESS row alongside
/// `processing → success`, a FAILED(PERMANENT) row alongside
/// `processing → failed`. A transient attempt's FAILED(TEMPORARY) row is
/// appended right after the aborted claim transaction rolls back (recording
/// that the attempt actually ran and was retried); on retry exhaustion the
/// final attempt's row is upserted atomically with `queued → failed`. Rows are
/// never deleted.
model EventAttempt {
  id            String             @id @default(uuid())
  eventId       String             @map("event_id")
  attemptNumber Int                @map("attempt_number")
  status        AttemptStatus
  errorType     AttemptErrorType?  @map("error_type")
  failedReason  String?            @map("failed_reason")
  result        Json?
  createdAt     DateTime           @default(now()) @map("created_at")

  @@unique([eventId, attemptNumber])
  @@index([eventId])
  @@map("event_attempts")
}

/// One row per running worker process, upserted on a heartbeat cadence
/// (`WORKER_HEARTBEAT_INTERVAL_MS`). Backs the `/health` worker-liveness
/// check: a worker whose `lastSeenAt` is older than `HEALTH_WORKER_STALE_MS`
/// is reported stale and degrades the endpoint. worker_id = `WORKER_ID` env
/// or `${hostname}:${pid}`.
model WorkerHeartbeat {
  workerId   String   @id @map("worker_id")
  hostname   String
  startedAt  DateTime @map("started_at")
  lastSeenAt DateTime @map("last_seen_at")

  @@map("worker_heartbeats")
}