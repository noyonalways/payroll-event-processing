{"name": "@repo/worker", "version": "0.0.0", "private": true, "description": "BullMQ consumer entrypoint (design D4): main.ts bootstraps the WorkerModule from @repo/core. Keeps its own narrower configuration schema — it validates its own environment subset and needs no signing key (design open question).", "scripts": {"build": "nest build", "dev": "nest start --watch", "start": "node dist/main.js", "lint": "eslint \"src/**/*.ts\"", "typecheck": "tsc --noEmit -p tsconfig.json"}, "dependencies": {"@nestjs/common": "^11.0.0", "@nestjs/config": "^4.0.0", "@nestjs/core": "^11.0.0", "@repo/core": "workspace:*", "reflect-metadata": "^0.2.2"}, "devDependencies": {"@nestjs/cli": "^11.0.0", "@nestjs/schematics": "^11.0.0", "@repo/eslint-config": "workspace:*", "@repo/typescript-config": "workspace:*", "@types/node": "^22.0.0", "eslint": "^9.0.0", "typescript": "^5.7.0"}}