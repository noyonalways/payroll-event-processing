# ── .env.example — the committed template ──────────────────────────────────────────
# Template lives at the workspace root; the real stage files live with the API
# app (design D7, amended). Copy this file to `apps/api/.env.development` (or
# `.env.test` / `.env.production`) and adjust per stage. `NODE_ENV` selects the
# file at runtime: both apps resolve `apps/api/.env.${NODE_ENV}` to an absolute
# path, so the same file loads however the app is launched. Both apps fail to
# start, naming the file, when it is absent and the variables were not injected
# another way (docker compose injects them as environment variables).
# The Prisma CLI reads `packages/database/.env` — a plain `.env`, because the
# CLI does not read `.env.<NODE_ENV>`.

NODE_ENV=development
PORT=3000

# Log level for NestJS built-in logger — applied at bootstrap by both the API
# and the worker (src/common/logger/log-levels.ts).
# Options: log | error | warn | debug | verbose
#   log (default)   — the reviewer arc: submission idempotency, Processing …
#                     started, and the terminal succeeded/retrying/exhausted
#                     verdicts. Per-event relay breadcrumbs stay hidden.
#   debug / verbose — re-enable the road noise (Enqueued …, Relaying next …).
LOG_LEVEL=log

# ── PostgreSQL ────────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# For host runs (npm run dev / test) use `localhost`. In docker compose the
# api/worker services override this with the `postgres` service name.
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll?schema=public

# ── Redis / BullMQ ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Simulated Payroll Processor ────────────────────────────────────────────────────
# Probability (0.0 – 1.0) of a transient failure on each processing attempt
PAYROLL_TEMPORARY_FAILURE_RATE=0.25
# Probability (0.0 – 1.0) of a permanent (non-retryable) failure
PAYROLL_PERMANENT_FAILURE_RATE=0.05
# Deterministic override for tests / e2e. Options:
#   random (default) | always-success | always-transient | always-permanent
PAYROLL_FAILURE_MODE=random
#
# Reviewer demo lever — a reserved payload employeeId forces an outcome per
# submission, regardless of the env mode above (works from the UI, Swagger, or
# curl; no validation change — employeeId stays free-form):
#   EMP-DEMO-SUCCESS    → success on attempt 1
#   EMP-DEMO-RECOVER    → transient on attempts 1–2, success at attempt 3
#   EMP-DEMO-TRANSIENT  → always transient → exhausted at max attempts (failed)
#   EMP-DEMO-FAILAFTER  → transient on attempts 1–2, permanent failure at attempt 3 (failed)
#   EMP-DEMO-PERMANENT  → permanent failure on attempt 1
# EMP-DEMO-RECOVER / EMP-DEMO-FAILAFTER need the default PAYROLL_MAX_RETRY_ATTEMPTS=5
# (their thresholds are attempt 3). Any other EMP-DEMO-* suffix falls through to the env
# mode. See src/processing/demo-scenarios.ts for the authoritative mapping.

# ── Retry / Failure Strategy ────────────────────────────────────────────────────────
# Maximum number of BullMQ attempts per job before the event is permanently failed.
# Each retry uses exponential backoff: delay = PAYROLL_RETRY_BASE_DELAY_MS * 2^(attempt-1)
PAYROLL_MAX_RETRY_ATTEMPTS=5
# Base delay (ms) for exponential backoff. Attempt 1 = base, attempt 2 = 2*base, etc.
PAYROLL_RETRY_BASE_DELAY_MS=1000

# ── Idempotency Layer ───────────────────────────────────────────────────────────────
# How long a stored idempotency response stays valid (seconds). Resubmitting a key
# within this window replays the stored response; after it, the key starts a new operation.
IDEMPOTENCY_TTL_SECONDS=86400
# How often (ms) expired idempotency records are swept from idempotency_records.
IDEMPOTENCY_SWEEP_INTERVAL_MS=60000

# ── Worker Recovery & Liveness ──────────────────────────────────────────────────────
# BullMQ stalled-job detection (worker side). lockDuration must exceed the max
# processing-transaction duration (10 s) so a healthy worker never false-stalls.
# A job whose worker dies is re-queued after stalledInterval; maxStalledCount
# caps how many times a stalled job is re-queued before being marked failed.
PAYROLL_WORKER_LOCK_DURATION_MS=30000
PAYROLL_WORKER_STALLED_INTERVAL_MS=30000
PAYROLL_WORKER_MAX_STALLED_COUNT=1
# Heartbeat upsert cadence (ms) per worker into worker_heartbeats.
WORKER_HEARTBEAT_INTERVAL_MS=5000
# API-side: /health marks a worker stale when its last heartbeat (last_seen_at)
# is older than this many ms.
HEALTH_WORKER_STALE_MS=15000

# ── Authentication & Tenancy ────────────────────────────────────────────────────────
# HMAC-SHA256 key used to sign access tokens. REQUIRED, and at least 32 characters:
# the application refuses to boot without it, so it can never silently run with an
# empty or well-known signing key (which would let anyone mint a token for any
# organization). Generate a distinct value per stage:
#   openssl rand -base64 48
AUTH_JWT_SECRET=replace-me-with-a-long-random-per-stage-secret-value

# Access-token lifetime. Keep it short: access tokens are stateless, so expiry is
# the only revocation that applies to them — the refresh path re-checks membership.
AUTH_ACCESS_TOKEN_TTL=15m

# Refresh-token lifetime in days. Refresh tokens ARE revocable (hashed rows in
# refresh_tokens that rotation consumes), so this can be long-lived.
AUTH_REFRESH_TOKEN_TTL_DAYS=30