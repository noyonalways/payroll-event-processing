# ── .env.* template (committed) ────────────────────────────────────────────────────
# Copy to `.env.development` / `.env.test` / `.env.production` and adjust per stage.
# `NODE_ENV` selects the file at runtime: ConfigModule loads `.env.${NODE_ENV}`.

NODE_ENV=development
PORT=3000

# Log level for NestJS built-in logger
# Options: log | error | warn | debug | verbose
LOG_LEVEL=log

# ── PostgreSQL ────────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# For host runs (npm run dev / test) use `localhost`. In docker compose the
# api/worker services override this with the `postgres` service name.
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll?schema=public

# ── Redis / BullMQ ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Simulated Payroll Processor ────────────────────────────────────────────────────
# Probability (0.0 – 1.0) of a transient failure on each processing attempt
PAYROLL_TEMPORARY_FAILURE_RATE=0.25
# Probability (0.0 – 1.0) of a permanent (non-retryable) failure
PAYROLL_PERMANENT_FAILURE_RATE=0.05
# Deterministic override for tests / e2e. Options:
#   random (default) | always-success | always-transient | always-permanent
PAYROLL_FAILURE_MODE=random

# ── Retry / Failure Strategy ────────────────────────────────────────────────────────
# Maximum number of BullMQ attempts per job before the event is permanently failed.
# Each retry uses exponential backoff: delay = PAYROLL_RETRY_BASE_DELAY_MS * 2^(attempt-1)
PAYROLL_MAX_RETRY_ATTEMPTS=5
# Base delay (ms) for exponential backoff. Attempt 1 = base, attempt 2 = 2*base, etc.
PAYROLL_RETRY_BASE_DELAY_MS=1000

# ── Idempotency Layer ───────────────────────────────────────────────────────────────
# How long a stored idempotency response stays valid (seconds). Resubmitting a key
# within this window replays the stored response; after it, the key starts a new operation.
IDEMPOTENCY_TTL_SECONDS=86400
# How often (ms) expired idempotency records are swept from idempotency_records.
IDEMPOTENCY_SWEEP_INTERVAL_MS=60000