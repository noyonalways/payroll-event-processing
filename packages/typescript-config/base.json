{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Options shared by every consumer today (root tsconfig.json + frontend
    // tsconfig.app.json). Flavour-specific options live in the presets.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}
